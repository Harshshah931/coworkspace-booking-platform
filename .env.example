# Development configuration example. Set these environment variables in your shell;
# Spring Boot does not automatically import this file without additional tooling.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@coworkspace.com
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

# Production PostgreSQL settings (only needed when using the prod profile)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/coworkspace
SPRING_DATASOURCE_USERNAME=replace-with-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
